# ---------- Telegram (majburiy) ----------
# @BotFather orqali olingan bot tokeni
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Kanal: @kanal_username yoki -100xxxxxxxxxx ko'rinishidagi ID. Bot kanalda ADMIN bo'lishi shart.
TELEGRAM_CHANNEL_ID=@your_channel

# ---------- Pinterest (ixtiyoriy) ----------
# Pinterest API v5 access token. Bo'sh qoldirilsa faqat scraper ishlatiladi.
# Eslatma: v5 "search/partner/pins" endpoint'i hamma akkauntlarga ochiq emas.
PINTEREST_ACCESS_TOKEN=
# Vergul bilan ajratilgan qidiruv so'zlari (bo'sh bo'lsa standart ro'yxat ishlatiladi)
PINTEREST_QUERIES=aesthetic wallpaper,profile pictures,phone aesthetic background,minimalist wallpapers
# Minimal rasm o'lchami (piksel) - HD sifat filtri. Faqat devor qog'ozlari kerak bo'lsa MIN_IMAGE_HEIGHT=1000 qiling.
MIN_IMAGE_WIDTH=720
MIN_IMAGE_HEIGHT=720
# Bitta so'z uchun maksimal sahifalar soni (har sahifada ~50 pin)
MAX_PAGES_PER_QUERY=15
# Ixtiyoriy proxy, masalan http://user:pass@host:port
PROXY_URL=

# ---------- Rejalashtirish ----------
TIMEZONE=Asia/Tashkent
# Vergul bilan ajratilgan HH:MM vaqtlar
POST_TIMES=09:00,21:00
IMAGES_PER_POST=10

# ---------- Boshqa ----------
DB_PATH=bot.db
LOG_FILE=bot.log
LOG_LEVEL=INFO
