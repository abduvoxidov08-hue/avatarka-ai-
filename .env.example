# ========================================================
# @avatarlar_uz Telegram Channel AI Agent Sozlamalari
# ========================================================

# 1. Telegram Bot Token (@BotFather orqali olingan)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Telegram Kanal ID yoki username (bot kanalda admin bo'lishi kerak!)
CHANNEL_ID=@avatarlar_uz

# 3. O'zingizning Telegram ID raqamingiz (@userinfobot orqali ko'rish mumkin)
ADMIN_TELEGRAM_ID=your_telegram_id_here

# 4. Google Gemini API Kaliti (https://aistudio.google.com/ dan bepul)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Media Qidiruv API Kalitlari (Ixtiyoriy, tavsiya etiladi)
# Pexels API (4K/HD rasm va vertikal videolar uchun bepul: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_key_optional

# Unsplash API (Badiiy estetik rasmlar uchun: https://unsplash.com/developers)
UNSPLASH_ACCESS_KEY=your_unsplash_key_optional

# 6. Mini App va Server Sozlamalari
PORT=8000
MINI_APP_URL=https://avatarlar-uz.netlify.app
