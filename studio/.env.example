# Bu fayldan nusxa oling:  cp .env.example .env   va qiymatlarni to'ldiring.
# .env faylini HECH QACHON GitHub'ga yuklamang (.gitignore da bor).

PORT=3000
# Ilova manzili. Kompyuteringizda: http://localhost:3000
# Internetga chiqarsangiz: https://sizning-domen.uz (cookie "secure" bo'ladi)
BASE_URL=http://localhost:3000

# --- Google OAuth (docs/GOOGLE_SOZLASH.md ga qarang) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Faqat shu emaillar kira oladi (vergul bilan ajrating)
ALLOWED_EMAILS=sizning.emailingiz@gmail.com

# --- Maxfiy kalitlar: `npm run kalit` buyrug'i ikkalasini yaratib beradi ---
SESSION_SECRET=
TOKEN_ENC_KEY=

# --- Gemini (Google AI Studio'dan, 2-bosqichda kerak bo'ladi) ---
GEMINI_API_KEY=

# Baza fayli joyi
DB_PATH=./data/office.db
